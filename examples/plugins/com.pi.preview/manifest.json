{
  "id": "com.pi.preview",
  "name": "文件预览",
  "description": "filePreview 贡献:txt/md/json/log + docx/xlsx/pptx 文本级预览(office.read 能力)",
  "version": "0.2.0",
  "engines": {
    "pi-desktop": ">=0.1.0"
  },
  "backend": "./dist/main.mjs",
  "permissions": [
    "filesystem"
  ],
  "contributes": {
    "panels": [
      {
        "id": "preview",
        "kind": "declarative",
        "title": "文件预览",
        "icon": "preview"
      }
    ],
    "filePreview": [
      {
        "match": [
          "txt",
          "md",
          "json",
          "log",
          "docx",
          "xlsx",
          "pptx"
        ]
      }
    ]
  }
}