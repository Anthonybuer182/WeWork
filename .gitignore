# Keep README screenshots
!assets/*.png
# Keep build icons
!apps/desktop/build/icon.png
!apps/desktop/build/icon.icns
# Keep vendored plugin assets (genoffice ribbon icons/textures). Without this
# the `*.png` rule above silently drops 75 files that the com.pi.files panel
# imports statically — a clean clone then fails `npm run build` with
# "Could not resolve .../icon-editor.png".
!plugins/*/vendor/**/*.png
!plugins/*/vendor/**/*.jpg
