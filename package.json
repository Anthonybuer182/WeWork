{
  "name": "pi-coding-agent-desktop",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "keywords": [
    "ai",
    "coding-assistant",
    "electron",
    "react",
    "desktop-app",
    "ai-programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Anthonybuer182/pi-coding-agent-desktop.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:market": "node scripts/setup.mjs --market",
    "verify:vendor": "node plugins/com.pi.files/scripts/vendor-genoffice.mjs --verify",
    "dev:web": "turbo run dev --filter=@pi/web",
    "dev:desktop": "node scripts/dev-plugin.mjs",
    "dev:desktop:raw": "turbo run dev --filter=@pi/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "turbo run clean",
    "pack:mac": "cd apps/desktop && pnpm pack:mac",
    "pack:win": "cd apps/desktop && pnpm pack:win",
    "pack:win:cross": "cd apps/desktop && pnpm pack:win:cross",
    "pack:linux": "cd apps/desktop && pnpm pack:linux",
    "pack:all": "cd apps/desktop && pnpm pack:all"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "win32"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^5.9.3"
  }
}
